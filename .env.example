# Optional Compose settings. Copy to .env and adapt to this machine.
# Use nonzero host UID/GID for output ownership; benchmark startup drops to these IDs.
LOCAL_UID=1000
LOCAL_GID=1000
# Use a stable, unique machine label when collecting repeated runs.
BENCHMARK_HOSTNAME=ketos-benchmarking
TRAINING_DATA_DIR=./training_data
ARTIFACTS_DIR=./artifacts/docker
CACHE_DIR=./.docker-cache
SITE_DIR=./site
SHM_SIZE=2gb
DOCS_PORT=8000

# Shared 12-vCPU / 31-GiB Linux VM: opt into runtime resource limits.
# COMPOSE_FILE=compose.yaml:compose.limits.yaml
